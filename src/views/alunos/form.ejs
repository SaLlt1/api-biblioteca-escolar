<!-- Formulario de cadastro/edicao de aluno -->
<%- include('../partials/header', { titulo: livro ? 'Editar Livro' : 'Novo Livro' }) %>
<%- include('../partials/nav', { paginaAtual: 'livros' }) %>

<section class="novidades">

    <h2><%= livro ? 'Editar Livro' : 'Cadastrar Livro' %></h2>
    <p>
        Preencha os campos abaixo. Todos são obrigatórios, exceto a capa.
    </p>

    <div class="cardF">

        <% if (typeof erro !== 'undefined' && erro) { %>
            <p class="erro" style="display:block;"><%= erro %></p>
        <% } %>

        <form
            action="<%= livro ? '/livros/' + livro.getId() + '?_method=PUT' : '/livros' %>"
            method="POST"
            enctype="multipart/form-data"
            novalidate
        >

            <label for="titulo">Título</label>
            <input
                type="text"
                id="titulo"
                name="titulo"
                placeholder="Título do livro"
                value="<%= livro ? livro.getTitulo() : '' %>"
                required
                minlength="2"
            >

            <label for="autor">Autor</label>
            <input
                type="text"
                id="autor"
                name="autor"
                placeholder="Autor do livro"
                value="<%= livro ? livro.getAutor() : '' %>"
                required
                minlength="2"
            >

            <label for="anoPublicacao">Ano de publicação</label>
            <input
                type="number"
                id="anoPublicacao"
                name="anoPublicacao"
                placeholder="Ex: 2020"
                value="<%= livro ? livro.getAnoPublicacao() : '' %>"
                required
                min="1400"
            >

            <label for="capa">Capa do livro</label>
            <input
                type="file"
                id="capa"
                name="capa"
                accept="image/*"
            >

            <% if (livro && livro.getCapaUrl()) { %>
                <img src="<%= livro.getCapaUrl() %>" alt="Capa atual" width="80">
            <% } %>

            <button type="submit"><%= livro ? 'Salvar alterações' : 'Cadastrar' %></button>

        </form>

    </div>

</section>

<%- include('../partials/footer', { script: 'livros' }) %>