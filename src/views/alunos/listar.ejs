<!-- Listagem de alunos -->
<%- include('../partials/header', { titulo: 'Alunos' }) %>
<%- include('../partials/nav', { paginaAtual: 'alunos' }) %>

<section class="novidades">

    <h2>Alunos Cadastrados</h2>

    <p>
        <a href="/alunos/novo" class="botao">+ Novo Aluno</a>
    </p>

    <div class="pesquisa">
        <input
            type="search"
            id="buscaAlunos"
            placeholder="Buscar por nome ou turma..."
        >
        <button type="button" aria-label="Buscar">🔍</button>
    </div>

    <% if (alunos.length === 0) { %>

        <p class="centralizar mt">Nenhum aluno cadastrado ainda.</p>

    <% } else { %>

        <table id="tabelaAlunos">
            <thead>
                <tr>
                    <th>Nome</th>
                    <th>Turma</th>
                    <th>Matrícula</th>
                    <th>Ações</th>
                </tr>
            </thead>
            <tbody>
                <% alunos.forEach(function (aluno) { %>
                    <tr>
                        <td><%= aluno.getNome() %></td>
                        <td><%= aluno.getTurma() %></td>
                        <td><%= aluno.getMatricula() %></td>
                        <td>
                            <a href="/alunos/<%= aluno.getId() %>">Detalhes</a>
                            &nbsp;|&nbsp;
                            <a href="/alunos/<%= aluno.getId() %>/editar">Editar</a>
                            &nbsp;|&nbsp;
                            <form action="/alunos/<%= aluno.getId() %>?_method=DELETE" method="POST" style="display:inline"
                                  onsubmit="return confirm('Tem certeza que deseja remover este aluno?');">
                                <button type="submit" class="link-botao">Remover</button>
                            </form>
                        </td>
                    </tr>
                <% }); %>
            </tbody>
        </table>

    <% } %>

</section>

<%- include('../partials/footer', { script: 'alunos' }) %>