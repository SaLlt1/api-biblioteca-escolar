<!-- Listagem de emprestimos -->
<%- include('../partials/header', { titulo: 'Empréstimos' }) %>
<%- include('../partials/nav', { paginaAtual: 'emprestimos' }) %>

<section class="novidades">

    <h2>Empréstimos</h2>

    <p>
        <a href="/emprestimos/novo" class="botao">+ Novo Empréstimo</a>
    </p>

    <% if (emprestimos.length === 0) { %>

        <p class="centralizar mt">Nenhum empréstimo registrado ainda.</p>

    <% } else { %>

        <table id="tabelaEmprestimos">
            <thead>
                <tr>
                    <th>Livro</th>
                    <th>Aluno</th>
                    <th>Empréstimo</th>
                    <th>Devolução prevista</th>
                    <th>Status</th>
                    <th>Ações</th>
                </tr>
            </thead>
            <tbody>
                <% emprestimos.forEach(function (emprestimo) { %>
                    <% const livro = livros.find(function (l) { return l.getId() === emprestimo.getLivroId(); }); %>
                    <% const aluno = alunos.find(function (a) { return a.getId() === emprestimo.getAlunoId(); }); %>
                    <tr>
                        <td><%= livro ? livro.getTitulo() : 'Livro removido' %></td>
                        <td><%= aluno ? aluno.getNome() : 'Aluno removido' %></td>
                        <td><%= emprestimo.getDataEmprestimo() %></td>
                        <td><%= emprestimo.getDataDevolucaoPrevista() %></td>
                        <td><%= emprestimo.isDevolvido() ? 'Devolvido' : 'Em aberto' %></td>
                        <td>
                            <a href="/emprestimos/<%= emprestimo.getId() %>/editar">Editar</a>
                            &nbsp;|&nbsp;
                            <form action="/emprestimos/<%= emprestimo.getId() %>?_method=DELETE" method="POST" style="display:inline"
                                  onsubmit="return confirm('Tem certeza que deseja remover este empréstimo?');">
                                <button type="submit" class="link-botao">Remover</button>
                            </form>
                        </td>
                    </tr>
                <% }); %>
            </tbody>
        </table>

    <% } %>

</section>

<%- include('../partials/footer', { script: 'emprestimos' }) %>