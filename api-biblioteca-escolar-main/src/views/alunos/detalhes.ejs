<!-- Detalhes de um aluno -->
<%- include('../partials/header', { title: `${aluno.getNome()} | Biblioteca Escolar`, currentPath: '/alunos' }) %>
<%- include('../partials/nav') %>
<main>
  <section class="novidades">
      <p class="centralizar">Leitores cadastrados</p>
      <h2>Detalhes do aluno</h2>
      <p>
          Consulte as informações registradas para este estudante.
      </p>
      <div class="mt centralizar">
          <a href="/alunos" class="botao">← Voltar</a>
          <a href="/alunos/<%= aluno.getId() %>/editar" class="botao">Editar aluno</a>
      </div>
  </section>
  <section>
      <div class="cards">
          <article class="card">
              <h3><%= aluno.getNome() %></h3>
              <table>
                  <tr>
                      <th>Turma</th>
                      <td><%= aluno.getTurma() %></td>
                  </tr>
                  <tr>
                      <th>Matrícula</th>
                      <td><%= aluno.getMatricula() %></td>
                  </tr>
                  <tr>
                      <th>Situação</th>
                      <td>Cadastro ativo</td>
                  </tr>
              </table>
          </article>
          <aside class="card">
              <h3>Próximo passo</h3>
              <p>
                  Este aluno já pode ser selecionado ao registrar um novo empréstimo.
              </p>
              <div class="mt">
                  <a href="/emprestimos/novo" class="botao">
                      Registrar empréstimo
                  </a>
              </div>
          </aside>
      </div>
  </section>
</main>
<%- include("../partials/footer") %>